# Copy this template to secret storage outside Git; use placeholders, not real values.
DB_BACKEND=postgres

# Docker production defaults. Keep POSTGRES_PASSWORD and DATABASE_URL consistent.
POSTGRES_DB=teleroute
POSTGRES_USER=teleroute
POSTGRES_PASSWORD=<generate-a-strong-random-database-password>
DATABASE_URL=postgresql://teleroute:<same-password>@postgres:5432/teleroute

MVP_PRODUCTION_SECURITY=1
# Must be 32+ characters, generated securely at deploy time, and stable across restarts/releases.
MVP_AUTH_SECRET=<generate-a-strong-random-secret-at-deploy-time>

APP_BASE_URL=https://<production-host>
# Direct/non-container production defaults to loopback. docker-compose.production.yml
# overrides HOST to 0.0.0.0 inside the app container and publishes only host loopback.
HOST=127.0.0.1
PORT=8000
APP_PORT=8000

HLR_MODE=<demo-or-live>
HLR_API_URL=<hlr-api-url>
HLR_API_KEY=<hlr-api-key>
HLR_API_SECRET=<hlr-api-secret>
HLR_TIMEOUT_MS=30000
HLR_CONCURRENCY=1
HLR_DAILY_CHECK_LIMIT=500

TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=<telegram-chat-id>
