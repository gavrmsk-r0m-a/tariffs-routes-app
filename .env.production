# Production deploy template. Never put real secrets in this file.
# Values in ${...} are populated by GitLab CI/CD Variables during deploy.
DB_BACKEND=postgres

POSTGRES_DB=${POSTGRES_DB}
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Temporary while TeleRoute is served over internal HTTP. Remove when HTTPS is enabled.
MVP_ALLOW_INSECURE_HTTP=1
MVP_PRODUCTION_SECURITY=1
MVP_AUTH_SECRET=${MVP_AUTH_SECRET}

APP_BASE_URL=${APP_BASE_URL}
HOST=0.0.0.0
PORT=8000
APP_PORT=8000

HLR_MODE=${HLR_MODE}
HLR_API_URL=${HLR_API_URL}
HLR_API_KEY=${HLR_API_KEY}
HLR_API_SECRET=${HLR_API_SECRET}
HLR_TIMEOUT_MS=30000
HLR_CONCURRENCY=1
HLR_DAILY_CHECK_LIMIT=500

TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
TELEGRAM_CHAT_ID=${TELEGRAM_CHAT_ID}
