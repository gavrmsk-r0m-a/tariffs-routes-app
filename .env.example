# TeleRoute application runtime requires PostgreSQL and fails closed without both values.
DB_BACKEND=postgres
DATABASE_URL=postgresql://teleroute:change-me@localhost:5432/teleroute

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_BASE_URL=http://127.0.0.1:8000

HLR_MODE=demo
HLR_API_URL=https://api.hlrlookup.com/apiv2/hlr
HLR_API_KEY=
HLR_API_SECRET=
HLR_TIMEOUT_MS=30000
HLR_CONCURRENCY=1
HLR_DAILY_CHECK_LIMIT=500
